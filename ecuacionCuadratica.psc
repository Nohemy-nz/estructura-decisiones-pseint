Algoritmo ecuacionCuadratica
	Definir a, b, c, discriminante Como Real
	Escribir "ingrese numero a"
	Leer a
	Escribir "ingrese numero b:"
	Leer b
	Escribir "ingrese numero c:"
	Leer c
	discriminante = b^2 - 4 * a * c
	si discriminante >= 0 y  a<> 0 Entonces
		Escribir " la raiz tiene solucion"
	SiNo
		Escribir "la raiz no tiene solucion"
		
	FinSi
	
FinAlgoritmo
