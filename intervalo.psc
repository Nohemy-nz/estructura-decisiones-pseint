Algoritmo intervalo
	Definir x, valorMin, valorMax Como Entero
	
	Escribir "ingrese el valor minimo del intervalo:"
	Leer valorMin
	Escribir "ingresar el valor maximo del intervalo:"
	Leer valorMax
	Escribir "ingrese un numero:"
	Leer x
	si x>= valorMin y x<= valorMax Entonces
		Escribir "el numero se encuentra dentro del intervalo"
	SiNo
		Escribir "el numero no se encuentra dentro del intervalo"
	FinSi
	
FinAlgoritmo
